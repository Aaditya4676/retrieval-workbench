{
  "name": "retrieval-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3300",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3300",
    "data": "tsx scripts/data-service.ts",
    "ingest": "tsx scripts/ingest.ts",
    "eval": "tsx scripts/evaluate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mcp": "tsx packages/mcp-server/index.ts",
    "verify:mcp": "tsx scripts/verify-mcp.ts",
    "verify:browser": "tsx scripts/verify-browser.ts",
    "eval:generation": "tsx scripts/evaluate-generation.ts",
    "verify:generation": "tsx scripts/verify-generation.ts",
    "record": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@modelcontextprotocol/inspector": "2.5.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "playwright": "1.58.2",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp",
      "esbuild"
    ]
  }
}
